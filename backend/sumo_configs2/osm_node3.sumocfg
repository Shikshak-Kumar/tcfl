<?xml version="1.0" encoding="UTF-8"?>
<!-- node_3 — Residential/DDA colony (Dwarka sectors residential backbone): afternoon offset.
     Priority tier 3. Moderate residential traffic, evening return commute pattern.
     India urban: relaxed jam-threshold for wider residential roads. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml.gz"/>
        <route-files value="osm.passenger.trips.xml"/>
    </input>

    <time>
        <begin value="900"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <tls.actuated.jam-threshold value="32"/>
        <time-to-teleport value="75"/>
        <ignore-junction-blocker value="5"/>
        <collision.action value="teleport"/>
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="16"/>
        <device.rerouting.adaptation-interval value="10"/>
    </routing>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="osm.view.xml"/>
    </gui_only>

</sumoConfiguration>
