<?xml version="1.0" encoding="UTF-8"?>
<!-- node_0 — Metro/Hospital (Dwarka Mor). Priority tier 1. Same trips + [0,3600] as osm.sumocfg (paper parity).
     India urban: tight jam-threshold, elevated teleport patience for mixed traffic. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml"/>
        <route-files value="osm.passenger.trips.xml"/>
    </input>

    <!-- Same [0,3600] s window and trips as osm.sumocfg; node heterogeneity = TLS/processing only. -->
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <tls.actuated.jam-threshold value="18"/>
        <time-to-teleport value="45"/>
        <ignore-junction-blocker value="3"/>
        <collision.action value="teleport"/>
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="10"/>
        <device.rerouting.adaptation-interval value="6"/>
    </routing>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="osm.view.xml"/>
    </gui_only>

</sumoConfiguration>
