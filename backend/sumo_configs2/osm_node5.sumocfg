<?xml version="1.0" encoding="UTF-8"?>
<!-- node_5 — Metro/Highway feeder junction (Uttam Nagar–Dwarka Mor corridor): evening offset.
     Priority tier 3. High-frequency bus corridor, metro feeder autos, evening peak.
     India urban: medium jam-threshold, dynamic rerouting for metro-correlated demand spikes. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml.gz"/>
        <route-files value="generated/client2.trips.xml"/>
    </input>

    <time>
        <begin value="1500"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <tls.actuated.jam-threshold value="25"/>
        <time-to-teleport value="55"/>
        <ignore-junction-blocker value="4"/>
        <collision.action value="teleport"/>
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="12"/>
        <device.rerouting.adaptation-interval value="8"/>
    </routing>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="osm.view.xml"/>
    </gui_only>

</sumoConfiguration>
