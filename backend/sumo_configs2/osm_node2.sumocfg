<?xml version="1.0" encoding="UTF-8"?>
<!-- node_2 — Market/Commercial (Dwarka Mor). Priority tier 3. Same trips + [0,3600] as osm.sumocfg (paper parity).
     India urban: jam-threshold / rerouting tuned for commercial mix. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml"/>
        <route-files value="osm.passenger.trips.xml"/>
    </input>

    <!-- Research parity: same demand window as osm.sumocfg / other algorithms (begin=0). -->
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <tls.actuated.jam-threshold value="28"/>
        <time-to-teleport value="60"/>
        <ignore-junction-blocker value="5"/>
        <collision.action value="teleport"/>
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="14"/>
        <device.rerouting.adaptation-interval value="10"/>
    </routing>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="osm.view.xml"/>
    </gui_only>

</sumoConfiguration>
