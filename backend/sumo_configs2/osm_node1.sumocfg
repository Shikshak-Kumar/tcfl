<?xml version="1.0" encoding="UTF-8"?>
<!-- node_1 — School/Residential zone (Dwarka Sector 23 residential area): mid-morning offset.
     Priority tier 2. School rush at begin offset, moderate mixed traffic (autos, bikes, cars).
     India urban: medium jam-threshold, longer teleport for slow moving rickshaws. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml.gz"/>
        <route-files value="generated/client1.trips.xml"/>
    </input>

    <time>
        <begin value="300"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <tls.actuated.jam-threshold value="22"/>
        <time-to-teleport value="60"/>
        <ignore-junction-blocker value="4"/>
        <collision.action value="teleport"/>
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="12"/>
        <device.rerouting.adaptation-interval value="8"/>
    </routing>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="osm.view.xml"/>
    </gui_only>

</sumoConfiguration>
